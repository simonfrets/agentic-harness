{
  "name": "agentic-harness",
  "version": "0.1.0",
  "description": "Project-local six-agent software pipeline driven through vendor CLI adapters.",
  "license": "MIT",
  "bin": {
    "harness": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "runtime",
    "templates"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:sh": "sh scripts/shellcheck.sh",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:shell": "jest --selectProjects shell",
    "test:cov": "jest --coverage",
    "harness": "node dist/cli/index.js",
    "verify": "npm run typecheck && npm run lint && npm run lint:sh && npm run test:cov",
    "prepare": "husky"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picomatch": "^4.0.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@swc/core": "^1.7.35",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@types/picomatch": "^3.0.1",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0"
    ],
    "*.sh": [
      "sh scripts/shellcheck-staged.sh"
    ]
  }
}
